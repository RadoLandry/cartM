generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model Product {
  id               String                 @id @default(cuid())
  shopifyProductId String                 @unique
  shop             String
  title            String
  description      String?
  handle           String
  vendor           String?
  productType      String?
  status           ProductStatus          @default(ACTIVE)
  tags             String[]
  disciplineTags          String[]
  categoryTags            String[]
  classificationConfidence Float?
  isManuallyClassified     Boolean  @default(false)
  dominantColors           String[]
  collectionIds    String[]
  metafields       Json?
  embedding        Unsupported("vector")?
  syncedAt         DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  variants         ProductVariant[]
  visualProfile    ProductVisualProfile?
  classificationOverrides ProductClassificationOverride[]

  @@index([shop])
  @@index([status])
}

model ProductVariant {
  id                String   @id @default(cuid())
  shopifyVariantId  String   @unique
  productId         String
  title             String
  sku               String?
  price             Decimal? @db.Decimal(10, 2)
  compareAtPrice    Decimal? @db.Decimal(10, 2)
  sizeValue         String?
  sizeCategory      String?
  sizeNumeric       Float?
  inventoryQuantity Int?
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model SyncJob {
  id          String        @id @default(cuid())
  shop        String
  status      SyncJobStatus @default(PENDING)
  totalCount  Int           @default(0)
  syncedCount Int           @default(0)
  failedCount Int           @default(0)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([shop, status])
}

model WebhookEvent {
  id               String                  @id @default(cuid())
  eventId          String                  @unique
  shop             String
  topic            String
  payload          Json?
  processingStatus WebhookProcessingStatus @default(PENDING)
  receivedAt       DateTime                @default(now())
  processedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([shop, topic])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum SyncJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSED
  FAILED
  DUPLICATE
}

// ---------------------------------------------------------------------------
// Product Relationship Mapping
// ---------------------------------------------------------------------------

enum RelationshipType {
  COMPLEMENTS
  UPGRADES
  ALTERNATIVES
  CONFLICTS
  SAME_COLLECTION
}

enum RelationshipDirectionality {
  DIRECTIONAL
  SYMMETRIC
}

enum RelationshipStatus {
  CANDIDATE
  ACTIVE
  REJECTED
  INACTIVE
}

enum RelationshipOrigin {
  AUTO
  MERCHANT
}

enum EvidenceType {
  TAXONOMY
  COLLECTION
  COLORWAY
  EMBEDDING
  MERCHANT_RULE
  COPURCHASE
  CATALOG_METADATA
}

enum OverrideAction {
  CREATE
  UPDATE
  REJECT
  REACTIVATE
  DISABLE
}

model ProductRelationship {
  id               String                    @id @default(cuid())
  shop             String
  sourceProductId  String
  targetProductId  String
  relationshipType RelationshipType
  directionality   RelationshipDirectionality
  strength         Float                     @default(0)
  status           RelationshipStatus        @default(CANDIDATE)
  origin           RelationshipOrigin        @default(AUTO)
  evidenceSummary  Json?
  reviewedAt       DateTime?
  invalidatedAt    DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  evidence         RelationshipEvidence[]

  @@unique([shop, sourceProductId, targetProductId, relationshipType])
  @@index([shop, status])
  @@index([shop, sourceProductId])
  @@index([shop, targetProductId])
}

model RelationshipEvidence {
  id                     String              @id @default(cuid())
  productRelationshipId  String
  evidenceType           EvidenceType
  score                  Float               @default(0)
  details                Json?
  createdAt              DateTime            @default(now())
  relationship           ProductRelationship @relation(fields: [productRelationshipId], references: [id], onDelete: Cascade)

  @@index([productRelationshipId])
}

model RelationshipOverride {
  id                String         @id @default(cuid())
  shop              String
  normalizedPairKey String
  relationshipType  RelationshipType
  action            OverrideAction
  appliedState      Json?
  createdBy         String?
  createdAt         DateTime       @default(now())

  @@index([shop, normalizedPairKey, relationshipType])
}

// ---------------------------------------------------------------------------
// Size & Fit Intelligence
// ---------------------------------------------------------------------------

enum SizeChartSource {
  AUTO
  MERCHANT
}

enum SizeConflictSeverity {
  WARNING
  ERROR
}

/// Per-category size chart mapping body attributes to size labels.
/// breakpoints is an auto-generated array; overrideBreakpoints is the
/// merchant-supplied replacement and takes precedence when non-null.
model SizeChart {
  id                  String          @id @default(cuid())
  shop                String
  categoryTag         String
  sizeSystem          String
  breakpoints         Json
  overrideBreakpoints Json?
  source              SizeChartSource @default(AUTO)
  version             Int             @default(1)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([shop, categoryTag, sizeSystem])
  @@index([shop])
}

/// Expected size correspondence between two product categories.
/// Used for deterministic cart conflict detection.
model CrossSizeMapping {
  id                  String               @id @default(cuid())
  shop                String
  sourceCategoryTag   String
  sourceSize          String
  targetCategoryTag   String
  targetSize          String
  severityOnMismatch  SizeConflictSeverity @default(WARNING)
  source              SizeChartSource      @default(AUTO)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([shop, sourceCategoryTag, sourceSize, targetCategoryTag])
  @@index([shop, sourceCategoryTag])
  @@index([shop, targetCategoryTag])
}

/// Individual return event used to statistically adjust size chart breakpoints.
model SizeReturnRecord {
  id                       String   @id @default(cuid())
  shop                     String
  shopifyOrderId           String
  shopifyProductId         String
  categoryTag              String
  returnedSize             String
  returnReason             String
  returnedAt               DateTime
  processedForAdjustment   Boolean  @default(false)
  createdAt                DateTime @default(now())

  @@index([shop, categoryTag])
  @@index([shop, processedForAdjustment])
}

/// Persisted customer size profile.
/// Used by getSizeRecommendation() for profile-first resolution (source:"profile").
model CustomerProfile {
  id                 String   @id @default(cuid())
  shop               String
  shopifyCustomerId  String?
  sessionId          String?
  /// JSON map of categoryTag → known size label, e.g. { "clothing": "M", "gloves_oz": "14oz" }
  sizeProfile        Json     @default("{}")
  disciplineProfile  Json     @default("{}")
  explicitProfile    Json     @default("{}")
  purchaseSummary    Json     @default("{}")
  behaviorSummary    Json     @default("{}")
  confidenceSummary  Json     @default("{}")
  lastActiveAt       DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([shop, shopifyCustomerId])
  @@unique([shop, sessionId])
  @@index([shop])
}

enum ReplenishmentDefaultAction {
  REORDER
  UPGRADE_OPTIONAL
}

enum ReplenishmentRuleSource {
  SEEDED
  MERCHANT
}

enum ReplenishmentPreferredAction {
  REORDER
  UPGRADE
}

model ReplenishmentLifecycleRule {
  id             String                     @id @default(cuid())
  shop           String
  categoryTag    String
  label          String
  windowMinDays  Int
  windowMaxDays  Int
  priority       Int                        @default(100)
  defaultAction  ReplenishmentDefaultAction @default(REORDER)
  source         ReplenishmentRuleSource    @default(SEEDED)
  isActive       Boolean                    @default(true)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@unique([shop, categoryTag])
  @@index([shop, isActive])
  @@index([shop, priority])
}

model CustomerPurchaseSnapshot {
  id                  String                       @id @default(cuid())
  shop                String
  shopifyCustomerId   String
  productId           String
  variantId           String?
  categoryTag         String
  firstPurchasedAt    DateTime
  lastPurchasedAt     DateTime
  lastOrderId         String?
  orderCount          Int                          @default(1)
  totalQuantity       Int                          @default(1)
  latestTitle         String
  latestVariantTitle  String?
  currencyCode        String?
  lastUnitPrice       Decimal?                     @db.Decimal(10, 2)
  inferredCadenceDays Int?
  preferredAction     ReplenishmentPreferredAction @default(REORDER)
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@unique([shop, shopifyCustomerId, productId, categoryTag])
  @@index([shop, shopifyCustomerId])
  @@index([shop, categoryTag])
  @@index([shop, shopifyCustomerId, lastPurchasedAt])
}

// ---------------------------------------------------------------------------
// Colorway & Collection Tracking
// ---------------------------------------------------------------------------

enum VisualProfileSource {
  AUTO
  MERCHANT
  HYBRID
}

enum VisualReviewStatus {
  NEEDS_REVIEW
  AUTO_APPROVED
  MERCHANT_REVIEWED
}

enum ColorCompatibility {
  MATCHING
  COMPLEMENTARY
  NEUTRAL
  AVOID
}

enum KitDefinitionSource {
  AUTO
  MERCHANT
  HYBRID
}

enum KitDefinitionStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum RequirementMatchMode {
  CATEGORY
  PRODUCT
  CATEGORY_OR_PRODUCT
  PRODUCT_OR_ALTERNATIVE
}

enum BundleRuleSource {
  AUTO
  MERCHANT
  HYBRID
}

enum BundleRuleStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum BundleDiscountType {
  PERCENTAGE
  FIXED
}

enum BundleComponentMatchMode {
  CATEGORY
  PRODUCT
  VARIANT
  CATEGORY_OR_PRODUCT
}

enum ThresholdRuleSource {
  AUTO
  MERCHANT
  HYBRID
}

enum ThresholdRuleStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ThresholdBenefitType {
  FREE_SHIPPING
  DISCOUNT_TIER
  CUSTOM
}

enum ThresholdDuplicatePurchasePolicy {
  DISALLOW
  ALLOW_REPEATABLE
}

model ProductVisualProfile {
  id                   String              @id @default(cuid())
  productId            String              @unique
  shop                 String
  dominantColors       Json
  detectedColorwayKeys String[]
  overrideColorwayKeys String[]
  detectedCollections  Json
  overrideCollections  Json?
  visualConfidence     Float?
  reviewStatus         VisualReviewStatus  @default(NEEDS_REVIEW)
  source               VisualProfileSource @default(AUTO)
  extractionSummary    Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  product              Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shop, reviewStatus])
  @@index([shop, visualConfidence])
}

model ColorCompatibilityRule {
  id                String              @id @default(cuid())
  shop              String
  sourceColorwayKey String
  targetColorwayKey String
  compatibility     ColorCompatibility
  source            VisualProfileSource @default(MERCHANT)
  rationale         String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([shop, sourceColorwayKey, targetColorwayKey])
  @@index([shop, sourceColorwayKey])
  @@index([shop, targetColorwayKey])
}

model KitDefinition {
  id            String              @id @default(cuid())
  shop          String
  key           String
  label         String
  disciplineTag String
  description   String?
  source        KitDefinitionSource @default(AUTO)
  status        KitDefinitionStatus @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  requirements  KitRequirement[]

  @@unique([shop, key])
  @@index([shop, disciplineTag, status])
}

model KitRequirement {
  id                        String               @id @default(cuid())
  kitDefinitionId           String
  requirementKey            String
  label                     String
  description               String?
  isRequired                Boolean              @default(true)
  priority                  Int                  @default(100)
  safetyCritical            Boolean              @default(false)
  matchMode                 RequirementMatchMode @default(CATEGORY)
  acceptedCategoryTags      String[]
  acceptedShopifyProductIds String[]
  acceptedRelationshipTypes RelationshipType[]
  minQuantity               Int                  @default(1)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  kitDefinition             KitDefinition        @relation(fields: [kitDefinitionId], references: [id], onDelete: Cascade)

  @@unique([kitDefinitionId, requirementKey])
  @@index([kitDefinitionId, priority])
}

model BundleRule {
  id                  String             @id @default(cuid())
  shop                String
  key                 String
  label               String
  description         String?
  source              BundleRuleSource   @default(MERCHANT)
  status              BundleRuleStatus   @default(DRAFT)
  priority            Int                @default(100)
  completionThreshold Float              @default(0.8)
  discountType        BundleDiscountType
  discountValue       Decimal            @db.Decimal(10, 2)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  components          BundleRuleComponent[]

  @@unique([shop, key])
  @@index([shop, status, priority])
}

model BundleRuleComponent {
  id                        String                   @id @default(cuid())
  bundleRuleId              String
  componentKey              String
  label                     String
  description               String?
  isRequired                Boolean                  @default(true)
  sortOrder                 Int                      @default(100)
  matchMode                 BundleComponentMatchMode @default(CATEGORY_OR_PRODUCT)
  acceptedCategoryTags      String[]
  acceptedShopifyProductIds String[]
  acceptedShopifyVariantIds String[]
  minQuantity               Int                      @default(1)
  createdAt                 DateTime                 @default(now())
  updatedAt                 DateTime                 @updatedAt
  bundleRule                BundleRule               @relation(fields: [bundleRuleId], references: [id], onDelete: Cascade)

  @@unique([bundleRuleId, componentKey])
  @@index([bundleRuleId, sortOrder])
}

model ThresholdRule {
  id                        String                           @id @default(cuid())
  shop                      String
  key                       String
  label                     String
  description               String?
  source                    ThresholdRuleSource              @default(MERCHANT)
  status                    ThresholdRuleStatus              @default(DRAFT)
  priority                  Int                              @default(100)
  benefitType               ThresholdBenefitType
  benefitLabel              String
  targetSubtotal            Decimal                          @db.Decimal(10, 2)
  actionableWindow          Decimal                          @db.Decimal(10, 2)
  allowOvershoot            Boolean                          @default(false)
  maxSuggestions            Int                              @default(3)
  supportedDisciplineTags   String[]
  supportedCategoryTags     String[]
  excludedShopifyProductIds String[]
  duplicatePurchasePolicy   ThresholdDuplicatePurchasePolicy @default(DISALLOW)
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt

  @@unique([shop, key])
  @@index([shop, status, priority])
}

enum KnowledgeGraphOverrideDimension {
  DISCIPLINE
  CATEGORY
}

enum KnowledgeGraphEntityType {
  PRODUCT_INTELLIGENCE
  CLASSIFICATION_OVERRIDE
  RELATIONSHIP_RULE
  SIZE_MAPPING_RULE
  BULK_OPERATION
}

enum KnowledgeGraphChangeAction {
  CREATE
  UPDATE
  DELETE
  ACTIVATE
  DEACTIVATE
  BULK_APPLY
}

enum KnowledgeGraphBulkOperationType {
  RECLASSIFY
  RELATIONSHIP_UPDATE
  TAG_APPLY
  TAG_REMOVE
}

enum KnowledgeGraphBulkOperationStatus {
  PREVIEWED
  CONFIRMED
  RUNNING
  PARTIAL
  COMPLETED
  FAILED
  CANCELLED
}

model ProductClassificationOverride {
  id             String                         @id @default(cuid())
  shop           String
  productId      String
  dimension      KnowledgeGraphOverrideDimension
  overrideValues String[]
  isActive       Boolean                        @default(true)
  createdBy      String?
  supersededAt   DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  product        Product                        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([shop, productId])
  @@index([shop, isActive, dimension])
}

model KnowledgeGraphBulkOperation {
  id            String                           @id @default(cuid())
  shop          String
  operationType KnowledgeGraphBulkOperationType
  targetCount   Int
  previewHash   String
  initiatedBy   String?
  status        KnowledgeGraphBulkOperationStatus @default(PREVIEWED)
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt
  changeLogs    KnowledgeGraphChangeLog[]

  @@index([shop, status])
  @@index([shop, operationType])
}

model KnowledgeGraphChangeLog {
  id               String                   @id @default(cuid())
  shop             String
  actorId          String?
  entityType       KnowledgeGraphEntityType
  entityId         String
  action           KnowledgeGraphChangeAction
  beforeSnapshot   Json?
  afterSnapshot    Json?
  reason           String?
  bulkOperationId  String?
  createdAt        DateTime                 @default(now())
  bulkOperation    KnowledgeGraphBulkOperation? @relation(fields: [bulkOperationId], references: [id], onDelete: SetNull)

  @@index([shop, entityType, entityId])
  @@index([shop, createdAt])
  @@index([bulkOperationId])
}
