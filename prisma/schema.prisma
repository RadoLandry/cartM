generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

model Product {
  id               String                 @id @default(cuid())
  shopifyProductId String                 @unique
  shop             String
  title            String
  description      String?
  handle           String
  vendor           String?
  productType      String?
  status           ProductStatus          @default(ACTIVE)
  tags             String[]
  disciplineTags          String[]
  categoryTags            String[]
  classificationConfidence Float?
  isManuallyClassified     Boolean  @default(false)
  dominantColors           String[]
  collectionIds    String[]
  metafields       Json?
  embedding        Unsupported("vector")?
  syncedAt         DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  variants         ProductVariant[]

  @@index([shop])
  @@index([status])
}

model ProductVariant {
  id                String   @id @default(cuid())
  shopifyVariantId  String   @unique
  productId         String
  title             String
  sku               String?
  price             Decimal? @db.Decimal(10, 2)
  compareAtPrice    Decimal? @db.Decimal(10, 2)
  sizeValue         String?
  sizeCategory      String?
  sizeNumeric       Float?
  inventoryQuantity Int?
  imageUrl          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model SyncJob {
  id          String        @id @default(cuid())
  shop        String
  status      SyncJobStatus @default(PENDING)
  totalCount  Int           @default(0)
  syncedCount Int           @default(0)
  failedCount Int           @default(0)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([shop, status])
}

model WebhookEvent {
  id               String                  @id @default(cuid())
  eventId          String                  @unique
  shop             String
  topic            String
  payload          Json?
  processingStatus WebhookProcessingStatus @default(PENDING)
  receivedAt       DateTime                @default(now())
  processedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([shop, topic])
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum SyncJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum WebhookProcessingStatus {
  PENDING
  PROCESSED
  FAILED
  DUPLICATE
}

// ---------------------------------------------------------------------------
// Product Relationship Mapping
// ---------------------------------------------------------------------------

enum RelationshipType {
  COMPLEMENTS
  UPGRADES
  ALTERNATIVES
  CONFLICTS
  SAME_COLLECTION
}

enum RelationshipDirectionality {
  DIRECTIONAL
  SYMMETRIC
}

enum RelationshipStatus {
  CANDIDATE
  ACTIVE
  REJECTED
  INACTIVE
}

enum RelationshipOrigin {
  AUTO
  MERCHANT
}

enum EvidenceType {
  TAXONOMY
  COLLECTION
  EMBEDDING
  MERCHANT_RULE
  COPURCHASE
  CATALOG_METADATA
}

enum OverrideAction {
  CREATE
  UPDATE
  REJECT
  REACTIVATE
  DISABLE
}

model ProductRelationship {
  id               String                    @id @default(cuid())
  shop             String
  sourceProductId  String
  targetProductId  String
  relationshipType RelationshipType
  directionality   RelationshipDirectionality
  strength         Float                     @default(0)
  status           RelationshipStatus        @default(CANDIDATE)
  origin           RelationshipOrigin        @default(AUTO)
  evidenceSummary  Json?
  reviewedAt       DateTime?
  invalidatedAt    DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  evidence         RelationshipEvidence[]

  @@unique([shop, sourceProductId, targetProductId, relationshipType])
  @@index([shop, status])
  @@index([shop, sourceProductId])
  @@index([shop, targetProductId])
}

model RelationshipEvidence {
  id                     String              @id @default(cuid())
  productRelationshipId  String
  evidenceType           EvidenceType
  score                  Float               @default(0)
  details                Json?
  createdAt              DateTime            @default(now())
  relationship           ProductRelationship @relation(fields: [productRelationshipId], references: [id], onDelete: Cascade)

  @@index([productRelationshipId])
}

model RelationshipOverride {
  id                String         @id @default(cuid())
  shop              String
  normalizedPairKey String
  relationshipType  RelationshipType
  action            OverrideAction
  appliedState      Json?
  createdBy         String?
  createdAt         DateTime       @default(now())

  @@index([shop, normalizedPairKey, relationshipType])
}
