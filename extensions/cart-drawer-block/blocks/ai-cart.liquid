<div
  class="cartmind-chat-block"
  data-cartmind-chat-root
  data-cartmind-autodiscover="true"
  data-cartmind-placement="{{ block.settings.surface }}"
  data-config-id="cartmind-chat-config-{{ block.id }}"
  {{ block.shopify_attributes }}
></div>

<script type="application/json" id="cartmind-chat-config-{{ block.id }}">
  {
    "shop": {{ shop.permanent_domain | json }},
    "surface": {{ block.settings.surface | json }},
    "placementId": {{ block.id | json }},
    "appBaseUrl": {{ block.settings.app_base_url | json }},
    "bootstrapPath": {{ block.settings.bootstrap_path | json }},
    "recommendationsPath": {{ block.settings.recommendations_path | json }},
    "labels": {
      "launcherLabel": {{ block.settings.launcher_label | json }},
      "assistantGreeting": {{ block.settings.assistant_greeting | json }},
      "panelTitle": {{ block.settings.panel_title | json }},
      "fallbackMessage": {{ block.settings.fallback_message | json }}
    },
    "features": {
      "showRecommendations": {{ block.settings.show_recommendations | json }},
      "showKitCompleteness": {{ block.settings.show_kit_completeness | json }},
      "showSizeWarnings": {{ block.settings.show_size_warnings | json }},
      "showChatEntry": {{ block.settings.show_chat_entry | json }}
    },
    "cart": {
      "cartId": {{ cart.id | json }},
      "currencyCode": {{ cart.currency.iso_code | default: shop.currency | json }},
      "items": [
        {% for item in cart.items %}
          {
            "lineId": {{ item.key | json }},
            "productId": {{ item.product.id | json }},
            "productTitle": {{ item.product.title | json }},
            "variantId": {{ item.variant.id | json }},
            "variantTitle": {{ item.variant.title | json }},
            "quantity": {{ item.quantity | json }}
          }{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  }
</script>

{% schema %}
{
  "name": "CartMind chat",
  "target": "body",
  "javascript": "cartmind-chat.js",
  "settings": [
    {
      "type": "select",
      "id": "surface",
      "label": "Cart surface",
      "default": "cart_drawer",
      "options": [
        { "value": "cart_drawer", "label": "Cart drawer" },
        { "value": "cart_page", "label": "Cart page" }
      ]
    },
    {
      "type": "text",
      "id": "app_base_url",
      "label": "App base URL (without /api/app-proxy)",
      "default": "https://app.cartmind.io"
    },
    {
      "type": "text",
      "id": "bootstrap_path",
      "label": "Bootstrap app proxy path",
      "default": "/apps/cartmind-chat/chat-bootstrap"
    },
    {
      "type": "text",
      "id": "recommendations_path",
      "label": "Recommendations path",
      "default": "/api/ai/recommendations"
    },
    {
      "type": "text",
      "id": "launcher_label",
      "label": "Launcher label",
      "default": "Ask CartMind"
    },
    {
      "type": "text",
      "id": "panel_title",
      "label": "Panel title",
      "default": "CartMind chat"
    },
    {
      "type": "textarea",
      "id": "assistant_greeting",
      "label": "Greeting",
      "default": "Ask about fit, comparisons, or what works well with the items already in your cart."
    },
    {
      "type": "textarea",
      "id": "fallback_message",
      "label": "Fallback message",
      "default": "CartMind guidance is temporarily unavailable. Your cart still works normally."
    },
    {
      "type": "checkbox",
      "id": "show_recommendations",
      "label": "Show recommendation cards",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_kit_completeness",
      "label": "Show kit completeness",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_size_warnings",
      "label": "Show size warnings",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_chat_entry",
      "label": "Show chat entry",
      "default": true
    }
  ]
}
{% endschema %}